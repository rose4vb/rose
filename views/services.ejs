<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main">
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div>
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <%- icon('chevron-right') %>
          <span aria-current="page">Services</span>
        </nav>
        <p class="eyebrow">Treatments</p>
        <h1 class="page-hero__title">Every treatment,<br><em>one calm plan.</em></h1>
        <p class="page-hero__lede">Eight disciplines, one team, and a plan written for your mouth
          rather than a template. Start anywhere — we will tell you if you are in the right place.</p>
      </div>
      <aside class="page-hero__aside">
        <p>Not sure what you need? That is what the consultation is for. We will examine, explain
          the options, and you decide in your own time.</p>
      </aside>
    </div>
  </section>

  <section class="section services-page">
    <div class="container">
      <div class="services-page__grid">
        <% services.forEach(function (service, i) { %>
          <article class="service-card reveal" style="--i:<%= i % 3 %>">
            <a class="service-card__media" href="/services/<%= service.slug %>" tabindex="-1" aria-hidden="true">
              <img src="<%= service.image %>" alt="" width="640" height="400" loading="lazy">
            </a>
            <div class="service-card__body">
              <span class="service-card__icon"><%- icon(service.icon) %></span>
              <h2 class="service-card__title">
                <a href="/services/<%= service.slug %>"><%= service.name %></a>
              </h2>
              <p class="service-card__text"><%= service.blurb %></p>
              <div class="service-card__foot">
                <span class="service-card__price"><%= service.price %></span>
                <span class="service-card__arrow" aria-hidden="true"><%- icon('arrow-up-right') %></span>
              </div>
            </div>
          </article>
        <% }); %>
      </div>
    </div>
  </section>

  <%- include('partials/cta-band', {
    ctaTitle: 'Unsure where<br><em>to begin?</em>',
    ctaText: 'Book a consultation and we will map it out together — no treatment on the day, no pressure.'
  }) %>
</main>

<%- include('partials/footer') %>
<script src="/js/main.js" defer></script>
</body>
</html>
