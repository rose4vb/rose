<section class="section services" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head">
      <div class="section-head__lead">
        <p class="eyebrow">Our services</p>
        <h2 class="section-title" id="services-title">Complete<br><em>Dental Care</em></h2>
      </div>
      <div class="section-head__aside">
        <p>From preventive care to smile transformation, we offer comprehensive dental
          treatments tailored to your needs — always with the gentlest option first.</p>
        <a class="link-arrow" href="/services">View all treatments <%- icon('arrow-right') %></a>
      </div>
    </div>

    <div class="services__grid">
      <% services.forEach(function (service, i) { %>
        <article class="service-card reveal" style="--i:<%= i % 4 %>">
          <a class="service-card__media" href="/services/<%= service.slug %>" tabindex="-1" aria-hidden="true">
            <img src="<%= service.image %>" alt="" width="640" height="480" loading="lazy">
          </a>
          <div class="service-card__body">
            <span class="service-card__icon"><%- icon(service.icon) %></span>
            <h3 class="service-card__title">
              <a href="/services/<%= service.slug %>"><%= service.name %></a>
            </h3>
            <p class="service-card__text"><%= service.blurb %></p>
            <div class="service-card__foot">
              <span class="service-card__price"><%= service.price %></span>
              <span class="service-card__arrow" aria-hidden="true"><%- icon('arrow-up-right') %></span>
            </div>
          </div>
        </article>
      <% }); %>
    </div>
  </div>
</section>
