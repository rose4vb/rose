<section class="section dentist" aria-labelledby="dentist-title">
  <div class="container dentist__inner">
    <div class="dentist__visual">
      <span class="dentist__blush" aria-hidden="true"></span>
      <figure class="dentist__frame">
        <img src="<%= dentist.image %>" alt="<%= dentist.name %>, principal dentist at Sakura Smile"
             width="760" height="950" loading="lazy">
      </figure>
      <svg class="dentist__sprig" aria-hidden="true" viewBox="0 0 120 160">
        <path d="M60 158V30" stroke="currentColor" stroke-width="1" fill="none"/>
        <g fill="currentColor" opacity=".5">
          <ellipse cx="44" cy="54" rx="15" ry="7" transform="rotate(-32 44 54)"/>
          <ellipse cx="76" cy="72" rx="15" ry="7" transform="rotate(32 76 72)"/>
          <ellipse cx="46" cy="96" rx="13" ry="6" transform="rotate(-28 46 96)"/>
          <ellipse cx="74" cy="118" rx="13" ry="6" transform="rotate(28 74 118)"/>
        </g>
      </svg>
      <blockquote class="dentist__pull">
        <p>“The moment someone sees their own smile without flinching — that is the whole job.”</p>
      </blockquote>
    </div>

    <div class="dentist__copy">
      <p class="eyebrow">Meet your dentist</p>
      <h2 class="section-title" id="dentist-title">Expert Care.<br><em>A Gentle Approach.</em></h2>
      <p class="dentist__name"><%= dentist.name %> <span><%= dentist.credentials %></span></p>
      <p><%= dentist.bio %></p>

      <dl class="stats">
        <% dentist.stats.forEach(function (stat) { %>
          <div class="stat">
            <dt class="stat__icon"><%- icon(stat.icon) %><span class="sr-only"><%= stat.label %></span></dt>
            <dd>
              <span class="stat__value"><%= stat.value %></span>
              <span class="stat__label"><%= stat.label %></span>
            </dd>
          </div>
        <% }); %>
      </dl>

      <ul class="dentist__education">
        <% dentist.education.forEach(function (line) { %>
          <li><%- icon('check') %><span><%= line %></span></li>
        <% }); %>
      </ul>

      <a class="btn btn--outline" href="/about">Learn more about Dr. Ren <%- icon('arrow-right') %></a>
    </div>
  </div>
</section>
